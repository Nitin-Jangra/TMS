# 2. Display Name & "From" Address shown on customer greeting emails:
SMTP_FROM_NAME="MSquare Professionals Support"
EMAIL_FROM="MSquare Professionals Support <nitin98175@gmail.com>"

# 3. SMTP Credentials (Gmail / Custom SMTP):
# To send live emails from Gmail:
# - Ensure 2-Step Verification is active on your Google Account
# - Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# - Paste it in SMTP_PASS below (without quotes or with quotes, spaces don't matter)
# If SMTP_PASS is left empty, the system runs safely in simulated mode.
SMTP_USER="nitin98175@gmail.com"
SMTP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"

# 4. Optional: Resend API Key (alternative to SMTP):
RESEND_API_KEY=""

