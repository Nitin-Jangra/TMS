# Local variables for `opennextjs-cloudflare preview` (wrangler dev).
# Copy to `.dev.vars` — this example file is committed, .dev.vars is not.
NEXTJS_ENV=development

# Real email delivery through a Gmail account (optional — without these two
# values notifications are only recorded in the mailbox, nothing is sent).
# SMTP_PASS is a Google App Password: https://myaccount.google.com/apppasswords
# SMTP_USER=your-mailbox@gmail.com
# SMTP_PASS=abcdefghijklmnop
